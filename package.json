{
  "name": "local-file-shared",
  "version": "1.0.0",
  "description": "Application de partage de fichiers en réseau local",
  "main": "electron.js",
  "author": "Josue Bondo",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "desktop": "electron .",
    "dev": "electron .",
    "clean": "rmdir /s /q release",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "bonjour": "^3.5.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "electron": "26.6.10",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.localfileshared.desktop",
    "productName": "Local File Shared",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "icon": "icon.ico",
    "afterPack": "build/after-pack.js",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "compression": "maximum",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "**/*",
      "!shared/**",
      "!release/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
